; Copie este archivo como config.ini y ponga SUS datos. config.ini NO se sube a GitHub.
; No escriba comentarios en la misma linea de un valor: pasarian a formar parte del valor.
;
; servidor: nombre tal cual de su servidor. Para saberlo, ejecute en SSMS o Azure Data Studio:
;           SELECT @@SERVERNAME AS servidor;
;           Ejemplos:  localhost\SQLEXPRESS    o    localhost,1433
; usuario y clave: dejelos VACIOS para entrar con su sesion de Windows.
;           Para usar el usuario sa (o Linux) escriba usuario = sa y su clave, sin comillas.
[sqlserver]
driver = ODBC Driver 18 for SQL Server
servidor = localhost\SQLEXPRESS
base = Taller
usuario =
clave =
